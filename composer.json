{
  "name": "authio/authio",
  "description": "Authio PHP SDK — passwordless, multi-org auth for B2B apps.",
  "license": "MIT",
  "type": "library",
  "homepage": "https://authio.com",
  "version": "0.1.0",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Authio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Authio\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit"
  }
}
